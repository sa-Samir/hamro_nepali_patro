<?xml version="1.0" encoding="utf-8"?>
<!-- Small "Desk page": a tear-off calendar page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Season photo, shown only in the photo theme. -->
    <ImageView
        android:id="@+id/bg_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/month_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_desk_strip"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="7dp"
            android:text="असोज २०८३"
            android:textColor="@color/patro_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="१५"
            android:textColor="@color/widget_number"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="बिहीबार"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tithi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:text="कृष्ण पञ्चमी"
            android:textColor="@color/widget_gold"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
