<?xml version="1.0" encoding="utf-8"?>
<!-- Two lines of text; collapsed view for the week and countdown styles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/notification_card_forest"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.Compat.Notification.Title"
            android:textColor="@color/notification_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/TextAppearance.Compat.Notification.Line2"
            android:textColor="@color/notification_text_muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
