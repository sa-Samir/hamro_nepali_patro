<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed: a small tear-off page, weekday and tithi beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/notification_card_panel"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/notification_page_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/month"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:background="@drawable/notification_page_strip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/notification_today_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/notification_page_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:textColor="@color/notification_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/notification_text_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
