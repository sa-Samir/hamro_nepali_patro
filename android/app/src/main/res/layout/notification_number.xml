<?xml version="1.0" encoding="utf-8"?>
<!-- "Big number" style, collapsed: the BS day large, details beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/notification_card_panel"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:minWidth="40dp"
        android:textColor="@color/notification_number"
        android:textSize="30sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:textColor="@color/notification_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:textColor="@color/notification_text_muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
